# Example environment configuration for Outage Automation
# Copy to /etc/systemd/system/outage-automation.env or .env for local use.

# Web Dashboard credentials & binding
OA_DASHBOARD_USER=outage-viewer
OA_DASHBOARD_PASSWORD=change-me-to-a-secure-random-string
# Or specify a password file path instead:
# OA_DASHBOARD_PASSWORD_FILE=/etc/outage-automation/dashboard.pw

OA_DASHBOARD_HOST=127.0.0.1
OA_DASHBOARD_PORT=8765

# SSL/TLS Configuration (optional, default: disabled on 127.0.0.1)
OA_DASHBOARD_SSL=0
# OA_DASHBOARD_SSL_CERT=/etc/outage-automation/dashboard.crt
# OA_DASHBOARD_SSL_KEY=/etc/outage-automation/dashboard.key

# Ingest and Retention Settings
OA_ROOT=/opt/outage-automation
OA_LOG_LEVEL=info
OA_LOG_FORMAT=json
OA_TTL_DAYS=7
OA_EVENTS_RETENTION_DAYS=90

# Backup configuration (Restic)
OA_BACKUP_DEST=/var/backups/outage-automation
OA_RESTIC_REPO=/var/backups/oa-restic
OA_RESTIC_PASSWORD_FILE=/etc/outage-automation/restic.pw
