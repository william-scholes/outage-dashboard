#!/usr/bin/env bash
# Thin wrapper around `python run.py` for Linux / POSIX systems.
# Set OA_ROOT to override the resolved state root (default: cwd).
set -euo pipefail

# Resolve the python_system directory from the location of this script.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PY_SYSTEM_DIR="$(cd -- "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"
RUN_PY="${PY_SYSTEM_DIR}/run.py"

if [[ ! -f "${RUN_PY}" ]]; then
    echo "oa: cannot find run.py at ${RUN_PY}" >&2
    exit 1
fi

PYTHON_BIN="${OA_PYTHON:-python3}"
if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi

exec "${PYTHON_BIN}" "${RUN_PY}" "$@"
